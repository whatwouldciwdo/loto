# ==========================================================================
# LOTO Application — Production Environment Configuration (.env.prod.example)
# Copy this file to .env on your Ubuntu production server.
# ==========================================================================

# --------------------------------------------------------------------------
# Database (PostgreSQL) — External Server
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:Cilego2026.@10.8.140.69:5432/loto_db"

# --------------------------------------------------------------------------
# JWT Configuration (Wajib ganti string acak minimal 32 karakter di server)
# Generate: openssl rand -base64 48
# --------------------------------------------------------------------------
JWT_SECRET="ganti_dengan_random_secret_string_minimal_32_karakter"

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
NODE_ENV=production

# Public URL aplikasi yang diakses via browser (sesuaikan IP/Domain dan Port Server Ubuntu)
# Contoh port 3003 sesuai mapping di docker-compose.prod.yml (3003:3000)
NEXT_PUBLIC_API_URL=http://10.8.140.67:3003

# --------------------------------------------------------------------------
# WhatsApp Notifications (WAHA)
# Dashboard: http://10.8.140.67:3010/dashboard/
# --------------------------------------------------------------------------
WHATSAPP_API_URL=http://10.8.140.67:3010
WHATSAPP_API_KEY=
WHATSAPP_SESSION=LOTO

# Opsional: Nomor WhatsApp untuk testing notifikasi
WHATSAPP_TEST_PHONE=6287814111808
